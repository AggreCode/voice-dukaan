# --- database (docker compose default) ---
DATABASE_URL=postgresql+asyncpg://vd:vd@db:5432/voicedukan
# for running backend directly on the host against the compose db:
# DATABASE_URL=postgresql+asyncpg://vd:vd@localhost:5433/voicedukan

# --- app secret (signs login tokens and PIN hashes) ---
# Generate one: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Leave empty locally and tokens fall back to the old AI-key-derived secret, which breaks every
# time a key changes. Production must set it (render.yaml generates one).
APP_SECRET=

# --- Sarvam AI (primary STT) ---
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
SARVAM_MODE=transcribe            # transcribe | codemix | verbatim | translit
SARVAM_TRANSLATE_VIEW=false       # true = extra mode=translate call (doubles STT cost), English view for the LLM
SARVAM_LANGUAGE=unknown           # unknown = auto-detect (code-mixed friendly), or od-IN / hi-IN / en-IN
# Boosting catalog words in the speech engine backfired: "battery" was heard as "biscuit" because
# three biscuit products were boosted. Keep off unless an eval shows it helps.
STT_KEYTERMS=off                  # off | aliases | names

# --- which extractor maps transcript -> items ---
# gemini (cheap default) | claude (needs ANTHROPIC_API_KEY) | mock (zero cost, no matching)
EXTRACTOR_MODE=gemini

# --- Gemini (extraction, default). Free key: aistudio.google.com -> Get API key ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal     # minimal | low | medium | high

# --- sessions ---
SESSION_DAYS=30                    # "keep me signed in on this phone"
SESSION_SHORT_DAYS=1
# A Secure cookie is refused over plain HTTP. Browsers make an exception for localhost, so leave this
# true unless you are testing over a LAN IP such as http://192.168.1.5:5173.
COOKIE_SECURE=true

# --- reading a photographed list (the scan path) ---
# gemini = the key above, no new dependency | mock = zero cost, invents nothing (for tests)
OCR_MODE=gemini
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_THINKING_LEVEL=low   # minimal | low | medium | high
MAX_IMAGES_PER_SCAN=3
KEEP_IMAGES=false                  # photos are read in memory and dropped. Debug only: true

# --- Anthropic (extraction, optional) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium              # low | medium | high

# --- Google Cloud STT v2 (shadow only; optional) ---
GOOGLE_SHADOW_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json
GOOGLE_PROJECT_ID=
GOOGLE_SHADOW_MODELS=chirp_2:asia-southeast1
GOOGLE_SHADOW_TO_LLM=false

# --- app ---
DATA_DIR=/data
MAX_RECORDING_SECONDS=90
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=INFO
PORT=7860
